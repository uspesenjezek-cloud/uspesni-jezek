# Uspešni Ježek — varna POS/Openapi produkcijska predloga.
# Vrednosti skrivnosti dodaj samo v Vercel ali lokalni .env.local; te datoteke ne
# spreminjaj v zbirko pravih ključev. Vsa plačljiva in produkcijska stikala so
# namenoma privzeto zaprta.

# Supabase (obvezno za strežniški POS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Openapi Invoice
OPENAPI_INVOICE_TOKEN=
OPENAPI_INVOICE_TOKEN_EXPIRES_AT=
OPENAPI_INVOICE_MODE=sandbox
POS_OPENAPI_INVOICE_ENABLED=false
OPENAPI_INVOICE_SEND_ENABLED=false
OPENAPI_INVOICE_WEBHOOK_SECRET=
OPENAPI_INVOICE_WEBHOOK_URL=https://uspesni-jezek.vercel.app/api/pos?handler=openapi-invoice&webhook=1
OPENAPI_INVOICE_WEBHOOK_PUBLIC_PREFLIGHT_CONFIRMED=false
OPENAPI_INVOICE_WEBHOOK_PUBLIC_PREFLIGHT_URL=
OPENAPI_INVOICE_WEBHOOK_PUBLIC_PREFLIGHT_AT=
OPENAPI_INVOICE_ALLOW_CONFIGURATION_CREATE=false
OPENAPI_INVOICE_ALLOW_CONFIGURATION_UPDATE=false
OPENAPI_INVOICE_RECONCILIATION_ENABLED=false

# GoBD/WORM arhiv v Frankfurtu
POS_ARCHIVE_S3_REGION=eu-central-1
POS_ARCHIVE_S3_BUCKET=
POS_ARCHIVE_S3_ACCESS_KEY_ID=
POS_ARCHIVE_S3_SECRET_ACCESS_KEY=
POS_ARCHIVE_S3_SESSION_TOKEN=
POS_ARCHIVE_S3_LIVE_ENABLED=false
POS_ARCHIVE_S3_READINESS_CONFIRMED=false
POS_ARCHIVE_S3_READINESS_CONFIRMED_BUCKET=
POS_ARCHIVE_S3_READINESS_CONFIRMED_AT=
POS_ARCHIVE_S3_TEST_RETENTION_DAYS=7

# Poslovni produkcijski potrditvi
POS_DE_LEGAL_REVIEW_CONFIRMED=false
POS_DE_LEGAL_REVIEW_REFERENCE=
POS_DE_LEGAL_REVIEW_CONFIRMED_AT=
POS_DE_PILOT_ACCEPTED=false
POS_DE_PILOT_REFERENCE=
POS_DE_PILOT_ACCEPTED_AT=
