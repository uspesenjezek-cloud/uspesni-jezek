# Server-only POS archive configuration. Never put real values in this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# AWS S3 Object Lock, Frankfurt only.
POS_ARCHIVE_S3_REGION=eu-central-1
POS_ARCHIVE_S3_BUCKET=
POS_ARCHIVE_S3_ACCESS_KEY_ID=
POS_ARCHIVE_S3_SECRET_ACCESS_KEY=
POS_ARCHIVE_S3_SESSION_TOKEN=

# Keep false on the development account. Test objects use GOVERNANCE lock for
# 1-30 days. Enable only on the German company's production AWS account.
POS_ARCHIVE_S3_LIVE_ENABLED=false
POS_ARCHIVE_S3_TEST_RETENTION_DAYS=7
